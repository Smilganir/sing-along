# Frontend build-time configuration

# Absolute backend API URL (used when frontend and backend are on different hosts)
# Example: https://sing-along-api.onrender.com/api
# Leave unset for same-origin (Docker single container) or local dev.
# VITE_API_BASE=https://sing-along-api.onrender.com/api

# Base path for hosting under a subdirectory (e.g. GitHub Pages project page)
# Example: /Sing-Along/
# Leave unset to use './' (relative) in production builds.
# VITE_BASE_PATH=/Sing-Along/
