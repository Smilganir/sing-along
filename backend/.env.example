# Environment: development | prod
ENV=development

# CLI / server admin API token (X-Admin-Token header)
ADMIN_TOKEN=change-me

# Browser admin login (Unlock admin in the UI)
ADMIN_PASSWORD=change-me

# Random string for signing session cookies — e.g. openssl rand -hex 32
SESSION_SECRET=change-me

# Optional: session lifetime in seconds (default 7 days)
# SESSION_MAX_AGE=604800

# Database (SQLite default; use Postgres in production)
# DATABASE_URL=sqlite:///./data/singalong.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/singalong

# Comma-separated browser origins allowed to send cookies
# CORS_ORIGINS=https://your-user.github.io

# Cross-site cookie mode for split deploy (frontend != backend origin).
# Auto-enabled when ENV=prod; force on/off here if needed.
# SESSION_COOKIE_CROSS_SITE=true

# Path to built frontend for single-origin deploy (Docker sets this)
# STATIC_DIR=/app/static

# Google Takeout watch-history.json
# TAKEOUT_HISTORY_PATH=../data/takeout/Takeout/YouTube and YouTube Music/history/watch-history.json
